{
  "name": "@smsapi-linkmobility/n8n-nodes-smsapi",
  "version": "1.2.6",
  "description": "n8n community node for sending SMS messages through SMSAPI",
  "license": "MIT",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "sms",
    "smsapi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Velmanta-sp-z-o-o/smsapi-n8n.git"
  },
  "homepage": "https://github.com/Velmanta-sp-z-o-o/smsapi-n8n#readme",
  "author": {
    "name": "Velmanta sp.z.o.o",
    "email": "velmanta@velmanta.com"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SmsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SmsApi/SmsApi.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
